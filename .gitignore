# macOS
.DS_Store
.AppleDouble
.LSOverride

# OS / Editor
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# SAP / source data — must NEVER be committed (raw exports, full P&L, etc.)
*.xlsx
*.xlsm
*.tsv
*.pptx

# Block CSVs by default — except in analysis/outputs which is the
# audit-trail folder of derived metric tables that feed the deck.
*.csv
!analysis/outputs/*.csv

# Python — block top-level build scripts and caches,
# but ALLOW analysis/ which holds methodology lineage scripts.
/*.py
__pycache__/
.venv/
venv/

# Backup / scratch
*~
*.bak
*.orig
